@namespace MDD4All.DME.Views.Dialogs
@using MDD4All.UI.BlazorComponents.Dialog
<ModalDialog DialogType="ModalDialog.ModalDialogType.DeleteCancel"
             ConfirmText="Save anyway"
             Title="Data will be lost"
             OnClose="OnDialogClose">
    <div>
        <p>@DataContext.ComplexKeyWarningMessage</p>
        <p>The file stays readable for other tools, but the affected entries will be null afterwards.</p>
    </div>
</ModalDialog>
