@namespace MDD4All.DME.Views.Editor
@using MDD4All.DME.ViewModels.DataManager
@using MDD4All.UI.BlazorComponents.Localization
<div>

    @* The data models are compiled into the solution, so the catalogue can simply list them.
       Picking one creates an empty object of that type - there is no DLL to load first.

       Buttons rather than a select: a select only reports a change, so picking the same model
       twice in a row would do nothing the second time. *@
    <div class="btn-group">
        <button class="btn btn-outline-primary btn-sm dropdown-toggle" type="button"
                data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-file-earmark-plus"></i>
            New
        </button>
        <ul class="dropdown-menu">
            @foreach (Type dataModelType in Catalog.AvailableTypes)
            {
                <li>
                    <button class="dropdown-item" type="button"
                            @onclick="@(() => CreateNew(dataModelType))">
                        @dataModelType.Name
                    </button>
                </li>
            }
        </ul>
    </div>

    <button class="btn btn-outline-secondary btn-sm"
            @onclick="() => DataFile.OpenDataFileCommand.Execute(null)">
        <i class="bi bi-folder2-open"></i>
        Open
    </button>

    <button class="btn btn-outline-primary btn-sm"
            @onclick="() => DataFile.SaveDataFileCommand.Execute(null)">
        <i class="bi bi-save-fill"></i>
        Save
    </button>

    <button class="btn btn-outline-secondary btn-sm"
            @onclick="() => DataFile.SaveDataFileAsCommand.Execute(null)">
        <i class="bi bi-save"></i>
        Save as...
    </button>


    <LanguageSelection />
</div>
