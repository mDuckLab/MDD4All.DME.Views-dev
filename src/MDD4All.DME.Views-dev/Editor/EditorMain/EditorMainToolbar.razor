@namespace MDD4All.DME.Views.Editor
@using MDD4All.UI.BlazorComponents.Localization
<div>

    <img src="images/Synorvia_icon.png"
        class="btn btn-outline-secondary startButton" 
        @onclick="() => Navigation.ShowStartPage()" />

    <button class="btn btn-outline-primary btn-sm"
            @onclick="() => DataFile.SaveDataFileCommand.Execute(null)">
        <i class="bi bi-save-fill"></i>
        Save
    </button>

    <button class="btn btn-outline-secondary btn-sm"
            @onclick="() => DataFile.SaveDataFileAsCommand.Execute(null)">
        <i class="bi bi-save"></i>
        Save as...
    </button>

    <LanguageSelection />
</div>


