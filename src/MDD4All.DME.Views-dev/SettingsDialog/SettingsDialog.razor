@namespace MDD4All.DME.Views.SettingsDialog
@using MDD4All.UI.BlazorComponents.Dialog
@using MDD4All.UI.BlazorComponents.Localization

<ModalDialog Title="Einstellungen" DialogType="ModalDialog.ModalDialogType.Ok" OnClose="OnClose">
    <div class="settings-layout">
        <div class="settings-nav">
            <button type="button" class="settings-nav-item @(ActiveCategory == SettingsCategory.Global ? "active" : "")"
                    @onclick="@(() => ActiveCategory = SettingsCategory.Global)">
                Global
            </button>
            <button type="button" class="settings-nav-item @(ActiveCategory == SettingsCategory.Editor ? "active" : "")"
                    @onclick="@(() => ActiveCategory = SettingsCategory.Editor)">
                Editor
            </button>
            <button type="button" class="settings-nav-item @(ActiveCategory == SettingsCategory.Explorer ? "active" : "")"
                    @onclick="@(() => ActiveCategory = SettingsCategory.Explorer)">
                Explorer
            </button>
        </div>

        <div class="settings-content">
            @switch (ActiveCategory)
            {
                case SettingsCategory.Global:
                    <LanguageSelection />
                    <div class="settings-toggle">
                        <input class="form-check-input" type="checkbox" role="switch" id="saveTypeInformation" @bind="DataSettings.SaveTypeInformation" />
                        <label class="settings-toggle-label" for="saveTypeInformation">Typinformation mitspeichern</label>
                    </div>
                    <div class="settings-toggle">
                        <input class="form-check-input" type="checkbox" role="switch" id="writeComplexDictionaryKeys" @bind="DataSettings.WriteComplexDictionaryKeys" />
                        <label class="settings-toggle-label" for="writeComplexDictionaryKeys">
                            Dictionaries mit Objekt-Schlüssel speichern
                            <small class="settings-toggle-hint">
                                Aus: Andere Programme können die Datei lesen, diese Einträge werden aber als leer gespeichert.
                            </small>
                        </label>
                    </div>
                    <div class="settings-toggle">
                        <input class="form-check-input" type="checkbox" role="switch" id="confirmComplexKeyLoss" @bind="DataSettings.ConfirmComplexKeyLossWithDialog" />
                        <label class="settings-toggle-label" for="confirmComplexKeyLoss">
                            Warnung als Dialogfenster
                            <small class="settings-toggle-hint">
                                Aus: Es wird ohne Nachfrage gespeichert und erst danach in der Leiste gemeldet, was weggefallen ist.
                            </small>
                        </label>
                    </div>
                    break;

                case SettingsCategory.Editor:
                    <div class="settings-toggle">
                        <input class="form-check-input" type="checkbox" role="switch" id="editorTint" @bind="EditorSettings.TintEnabled" />
                        <label class="settings-toggle-label" for="editorTint">Farbe</label>
                    </div>
                    <div class="settings-toggle">
                        <input class="form-check-input" type="checkbox" role="switch" id="editorIcons" @bind="EditorSettings.ShowIcons" />
                        <label class="settings-toggle-label" for="editorIcons">Icons</label>
                    </div>
                    <div class="settings-toggle">
                        <input class="form-check-input" type="checkbox" role="switch" id="editorIndex" @bind="EditorSettings.ShowIndexNumbers" />
                        <label class="settings-toggle-label" for="editorIndex">Indexnummern</label>
                    </div>
                    <div class="settings-toggle">
                        <input class="form-check-input" type="checkbox" role="switch" id="editorReadOnlyBadges" @bind="EditorSettings.ShowReadOnlyBadges" />
                        <label class="settings-toggle-label" for="editorReadOnlyBadges">Readonly-Badges</label>
                    </div>
                    <div class="settings-toggle">
                        <input class="form-check-input" type="checkbox" role="switch" id="editorTypeBadges" @bind="EditorSettings.ShowTypeBadges" />
                        <label class="settings-toggle-label" for="editorTypeBadges">Typ-Badges</label>
                    </div>
                    break;

                case SettingsCategory.Explorer:
                    <div class="settings-toggle">
                        <input class="form-check-input" type="checkbox" role="switch" id="explorerIcons" @bind="ExplorerSettings.ShowIcons" />
                        <label class="settings-toggle-label" for="explorerIcons">Icons</label>
                    </div>
                    <div class="settings-toggle">
                        <input class="form-check-input" type="checkbox" role="switch" id="explorerIndex" @bind="ExplorerSettings.ShowIndexNumbers" />
                        <label class="settings-toggle-label" for="explorerIndex">Indexnummern</label>
                    </div>
                    <div class="settings-toggle">
                        <input class="form-check-input" type="checkbox" role="switch" id="explorerTypeSymbols" @bind="ExplorerSettings.ShowTypeSymbols" />
                        <label class="settings-toggle-label" for="explorerTypeSymbols">Typ-Symbole</label>
                    </div>
                    break;
            }
        </div>
    </div>
</ModalDialog>
