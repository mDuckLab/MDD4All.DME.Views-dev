@namespace MDD4All.DME.Views.SettingsDialog
@using MDD4All.UI.BlazorComponents.Dialog

<ModalDialog Title="Settings" DialogType="ModalDialog.ModalDialogType.Ok" OnClose="OnClose">
    <div class="settings-layout">
        <div class="settings-nav">
            <button type="button" class="settings-nav-item @(ActiveCategory == SettingsCategory.SaveOptions ? "active" : "")"
                    @onclick="@(() => ActiveCategory = SettingsCategory.SaveOptions)">
                Save options
            </button>
            <button type="button" class="settings-nav-item @(ActiveCategory == SettingsCategory.DataModels ? "active" : "")"
                    @onclick="@(() => ActiveCategory = SettingsCategory.DataModels)">
                Data models
            </button>
            <button type="button" class="settings-nav-item @(ActiveCategory == SettingsCategory.Editor ? "active" : "")"
                    @onclick="@(() => ActiveCategory = SettingsCategory.Editor)">
                Editor
            </button>
            <button type="button" class="settings-nav-item @(ActiveCategory == SettingsCategory.Explorer ? "active" : "")"
                    @onclick="@(() => ActiveCategory = SettingsCategory.Explorer)">
                Explorer
            </button>
        </div>

        <div class="settings-content">
            @switch (ActiveCategory)
            {
                case SettingsCategory.SaveOptions:
                    <div class="settings-toggle">
                        <input class="form-check-input" type="checkbox" role="switch" id="saveTypeInformation" @bind="DataSettings.SaveTypeInformation" />
                        <label class="settings-toggle-label" for="saveTypeInformation">Save type information</label>
                    </div>
                    break;

                case SettingsCategory.DataModels:
                    <div class="settings-toggle">
                        <input class="form-check-input" type="checkbox" role="switch" id="showAllDataModels" @bind="DataSettings.ShowAllDataModels" />
                        <label class="settings-toggle-label" for="showAllDataModels">
                            Show all types
                            <small class="settings-toggle-hint">
                                Off: only types a new object can be built from. On: every class in the data model assembly, including ones New cannot create.
                            </small>
                        </label>
                    </div>
                    break;

                case SettingsCategory.Editor:
                    <div class="settings-toggle">
                        <input class="form-check-input" type="checkbox" role="switch" id="editorIcons" @bind="EditorSettings.ShowIcons" />
                        <label class="settings-toggle-label" for="editorIcons">Icons</label>
                    </div>
                    <div class="settings-toggle">
                        <input class="form-check-input" type="checkbox" role="switch" id="editorReadOnlyBadges" @bind="EditorSettings.ShowReadOnlyBadges" />
                        <label class="settings-toggle-label" for="editorReadOnlyBadges">Read-only badges</label>
                    </div>
                    <div class="settings-toggle">
                        <input class="form-check-input" type="checkbox" role="switch" id="editorTypeBadges" @bind="EditorSettings.ShowTypeBadges" />
                        <label class="settings-toggle-label" for="editorTypeBadges">Type badges</label>
                    </div>
                    break;

                case SettingsCategory.Explorer:
                    <div class="settings-toggle">
                        <input class="form-check-input" type="checkbox" role="switch" id="explorerIcons" @bind="ExplorerSettings.ShowIcons" />
                        <label class="settings-toggle-label" for="explorerIcons">Icons</label>
                    </div>
                    <div class="settings-toggle">
                        <input class="form-check-input" type="checkbox" role="switch" id="explorerTypeSymbols" @bind="ExplorerSettings.ShowTypeSymbols" />
                        <label class="settings-toggle-label" for="explorerTypeSymbols">Type symbols</label>
                    </div>
                    break;
            }
        </div>
    </div>
</ModalDialog>
